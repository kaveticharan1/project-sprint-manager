# MongoDB connection string.
# Atlas:  mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Docker: mongodb://localhost:27017/?replicaSet=rs0&directConnection=true  (see docker-compose.yml)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database names. The app, seed script and tests refuse to touch any other database.
MONGODB_DB=sprint_manager
MONGODB_TEST_DB=sprint_manager_test

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
